# Docker Compose reads these optional values from a local .env file.
API_PORT=4000

# Runtime (used by `npm run dev` outside Docker Compose)
PORT=4000
NODE_ENV=production

# Data
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/kaya?retryWrites=true&w=majority

# Public URLs. The web URL is used to create share links.
PUBLIC_WEB_URL=https://www.kayaweb3.xyz
CORS_ORIGIN=https://kayaweb3.xyz,https://www.kayaweb3.xyz

# Paste defaults and limits
PASTE_DEFAULT_TTL_HOURS=24
PASTE_MAX_TTL_HOURS=168
PASTE_MAX_CHARACTERS=250000

# Optional image paste storage. Leave these unset to run text-only pastes.
# Prefer an IAM role on the server. If that is unavailable, set the AWS access keys below.
AWS_REGION=ap-southeast-1
S3_PASTE_BUCKET=your-kaya-paste-media-bucket
S3_PASTE_PREFIX=pastes
S3_PUBLIC_BASE_URL=https://your-kaya-paste-media-bucket.s3.ap-southeast-1.amazonaws.com
PASTE_MAX_IMAGE_BYTES=10485760
S3_UPLOAD_URL_TTL_SECONDS=300
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
