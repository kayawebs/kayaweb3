# Docker Compose reads these optional values from a local .env file.
API_PORT=4000

# Runtime (used by `npm run dev` outside Docker Compose)
PORT=4000
NODE_ENV=production

# Data
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/kaya?retryWrites=true&w=majority

# Public URLs. The web URL is used to create share links.
PUBLIC_WEB_URL=https://www.kayaweb3.xyz
CORS_ORIGIN=https://kayaweb3.xyz,https://www.kayaweb3.xyz

# Paste defaults and limits
PASTE_DEFAULT_TTL_HOURS=24
PASTE_MAX_TTL_HOURS=168
PASTE_MAX_CHARACTERS=250000
